{
  "name": "medkit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web && node scripts/offline.mjs",
    "preview": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm test && npm run build:web",
    "mcp": "node --import tsx integrations/mcp/stdio.ts",
    "mcp:grant": "node --import tsx integrations/mcp/grant-cli.ts",
    "mcp:revoke": "node --import tsx integrations/mcp/revoke-cli.ts",
    "build:native": "expo export --platform ios --platform android --output-dir dist-native",
    "server": "node --import tsx integrations/server/cli.ts",
    "server:account": "npm run server -- --create-account"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "express": "^5.3.0",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@expo/cli": {
      "glob": "14.0.2"
    },
    "@expo/fingerprint": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
