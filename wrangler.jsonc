{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medkit",
  "main": "integrations/cloudflare/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "send_metrics": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "vars": {
    "MEDKIT_BASE_URL": "http://127.0.0.1:8787",
    "MEDKIT_OAUTH_CLIENTS_JSON": "[]",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medkit",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "integrations/cloudflare/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "18431",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "18432",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
}
